# Copy to .env for local development. Never commit .env (it is git-ignored).
# On Vercel, set these under Project Settings > Environment Variables instead.

# Existing demo services
OPENAI_API_KEY=
TRIPADVISOR_API_KEY=
# Optional: send the plan requests through a proxy or a stand-in service instead of OpenAI (leave empty normally).
OPENAI_BASE_URL=
# Optional: addresses (comma-separated) of accounts with no free-trip limit, for your own testing. Everyone else gets 5.
UNLIMITED_TRIP_EMAILS=
# The itinerary map. A PUBLIC Mapbox token (starts with pk.), sent to the browser; restrict it to your site's addresses
# in the Mapbox dashboard. Without it the map says it could not load.
NUXT_PUBLIC_MAPBOX_TOKEN=

# Accounts ------------------------------------------------------------------------------------------------
# Nothing about accounts is ever saved on your machine, so every setting below is required, here and on Vercel.
# When one is missing, sign-up answers "Accounts are not available right now" and the server log says which.

# Seals the sign-in cookie. 32+ random characters, e.g.  openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# The Upstash Redis database that holds accounts, confirmation links and sign-in limits.
# On Vercel: Storage tab > Upstash > Redis, connect it to the project, and Vercel adds these two.
# Locally: copy the same two values here (or from a free database at upstash.com).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# The email service that sends the confirmation email. Fill in ONE of the two keys, and the sender.
BREVO_API_KEY=
RESEND_API_KEY=
# The "from" address, one the email service has verified:  Vacation Planner <hello@your-domain.com>
AUTH_EMAIL_FROM=

# Optional: the site's public address, for the link in the confirmation email (https://planner.example.com).
# Only needed when it cannot be worked out: on Vercel it is the project's own domain, locally it is the
# localhost address you opened the page on.
AUTH_BASE_URL=
